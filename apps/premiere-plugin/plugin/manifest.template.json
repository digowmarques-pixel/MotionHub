{
  "manifestVersion": 5,
  "id": "com.megalume.motionhub",
  "name": "Megalume Motion Hub",
  "version": "0.3.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "motionhub",
      "label": { "default": "Motion Hub", "pt-BR": "Motion Hub" },
      "minimumSize": { "width": 280, "height": 360 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["toolbar"] }
      ]
    }
  ],
  "icons": [
    { "width": 24, "height": 24, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": "__NETWORK_DOMAINS__" },
    "allowCodeGenerationFromStrings": false
  }
}
