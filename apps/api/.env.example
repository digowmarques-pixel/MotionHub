# Copie para .env e ajuste. Nunca versionar .env.
DATABASE_URL=postgres://motionhub:motionhub@localhost:5432/motionhub
PORT=8080
PUBLIC_URL=http://localhost:8080
# Segredo HS256 dos access tokens (mín. 32 bytes aleatórios)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32-bytes
# Chave Ed25519 (PEM PKCS8) para assinar manifests de pacotes; gere com `pnpm --filter @motionhub/api keygen`
PACK_SIGNING_KEY_PATH=./keys/pack-signing.pem
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=2048
CORS_ORIGINS=http://localhost:5173
