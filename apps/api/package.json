    "yazl": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/yazl": "^3.3.0",
    "tsx": "^4.20.0",
